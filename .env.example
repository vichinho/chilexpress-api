# =====================================================================
# Credenciales de Chilexpress (Portal Developers)
# ---------------------------------------------------------------------
# Cada "producto" que suscribes en https://developers.wschilexpress.com
# entrega su propia Subscription Key (Primary Key). Copia aqui la key
# que corresponda a cada producto.
#
# 1. Crea/entra a tu cuenta en developers.wschilexpress.com
# 2. Suscribe los productos: "Transport Orders" y "Tracking"
#    (y "Rates"/"Geo" si mas adelante quieres cotizar o validar comunas)
# 3. En "Profile" -> copia la Primary Key de cada producto
# =====================================================================

# Ambiente: "test" (pruebas) o "production" (produccion)
CHILEXPRESS_ENV=test

# Subscription Key del producto "Transport Orders" (Ordenes de Transporte)
CHILEXPRESS_TRANSPORT_ORDERS_KEY=tu_key_de_transport_orders_aqui

# Subscription Key del producto "Tracking" (Seguimiento)
CHILEXPRESS_TRACKING_KEY=tu_key_de_tracking_aqui

# (Opcional) timeout de las peticiones en milisegundos
CHILEXPRESS_TIMEOUT_MS=15000
