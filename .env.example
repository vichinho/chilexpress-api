# =====================================================================
# Credenciales de Chilexpress (Portal Developers)
# ---------------------------------------------------------------------
# Cada "producto" que suscribes en https://developers.wschilexpress.com
# entrega su propia Subscription Key (Primary Key). Copia aqui la key
# que corresponda a cada producto.
#
# 1. Entra a developers.wschilexpress.com con tu cuenta de empresa.
# 2. En el desplegable de productos, suscribe:
#    - "Envios"     -> genera ordenes de transporte y tracking
#    - "Coberturas" -> comunas / codigos de cobertura
#    (opcional: "Cotizador" para cotizar envios)
# 3. En "Tus Suscripciones" copia la Primary Key de cada una.
# =====================================================================

# Ambiente: "test" (pruebas) o "production" (produccion)
CHILEXPRESS_ENV=test

# Subscription Key del producto "Envios" (ordenes de transporte + tracking)
CHILEXPRESS_ENVIOS_KEY=tu_key_de_envios_aqui

# Subscription Key del producto "Coberturas" (comunas / codigos de cobertura)
CHILEXPRESS_COBERTURAS_KEY=tu_key_de_coberturas_aqui

# Tarjeta Cliente Chilexpress (TCC / customerCardNumber) de tu empresa
CHILEXPRESS_CARD_NUMBER=18570793

# (Opcional) timeout de las peticiones en milisegundos
CHILEXPRESS_TIMEOUT_MS=15000
